{:paths ["src"]
 ;; Sibling libraries are named by GIT COORDINATE, not :local/root.
 ;;
 ;; This library previously used :local/root and was therefore NOT consumable at
 ;; all from outside a monorepo checkout -- tools.deps resolves "../phone"
 ;; relative to the CONSUMER's gitlibs directory. Measured 2026-07-30, trying to
 ;; add it to cloud-itonami-app:
 ;;   Error building classpath. Local lib io.github.kotoba-lang/phone not found:
 ;;   ~/.gitlibs/libs/io.github.kotoba-lang/esim/phone
 ;; CI passed the whole time, because CI cloned the siblings into ../ -- proving
 ;; only that this compiles next to them, never that anyone else can use it.
 ;;
 ;; So :deps carry git coordinates, the :dev alias overrides them to sibling
 ;; checkouts for monorepo work, and CI runs the plain git path so a regression
 ;; in consumability fails CI instead of surfacing in a consumer.
 :deps {
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "0ffd5f6340af50871d4759b06e02ac4fbf9a4bdf"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/phone
        {:git/url "https://github.com/kotoba-lang/phone.git"
         :git/sha "4e9e01fb54f3f4f7256634f51eb8f352be7dd98b"}
        io.github.kotoba-lang/card
        {:git/url "https://github.com/kotoba-lang/card.git"
         :git/sha "488ec3252086380aeaad46d94d47766500ecb425"}}
 :aliases
 {:dev {:override-deps
        {io.github.kotoba-lang/phone {:local/root "../phone"}
         io.github.kotoba-lang/card  {:local/root "../card"}}}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
